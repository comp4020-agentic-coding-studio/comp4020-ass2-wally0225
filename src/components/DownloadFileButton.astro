---
// A pill-styled link that downloads a static file from public/ instead of
// navigating to it. withBase keeps the href correct under the site's
// GitHub Pages base path, same as the theme's own internal links.
import { withBase } from "astro-theme-university/url";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="download-file-button" href={withBase(href)} download>
  {label}
</a>

<style>
  .download-file-button {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 999px;
    background: var(--at-bg-alt);
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
</style>
